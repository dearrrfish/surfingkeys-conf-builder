{
  "schemaVersion": 1,
  "id": "developer",
  "extends": "./common.json",
  "searchGroups": [
    {
      "id": "dev",
      "name": "Developer Search",
      "leader": "ogd",
      "mode": "both",
      "engines": [
        "upstream/search-engines.ddg",
        {
          "name": "DevDocs",
          "url": "https://devdocs.io/#q={query}",
          "canIframe": true
        },
        {
          "name": "GitHub",
          "url": "https://github.com/search?q={query}&type=code",
          "canIframe": false
        },
        {
          "name": "StackOverflow",
          "url": "https://stackoverflow.com/search?q={query}",
          "canIframe": false
        }
      ]
    },
    {
      "id": "web",
      "name": "Web Multi-Search",
      "leader": "ogw",
      "mode": "tabs",
      "engines": [
        {
          "name": "Bing",
          "url": "https://www.bing.com/search?q={query}",
          "canIframe": true
        },
        {
          "name": "Wikipedia",
          "url": "https://zh.wikipedia.org/w/index.php?search={query}",
          "canIframe": true
        },
        {
          "name": "DuckDuckGo",
          "url": "https://duckduckgo.com/?q={query}",
          "canIframe": false
        }
      ]
    }
  ]
}
