    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@skcb/core": "^0.2.0"
  },
  "devDependencies": {
    "@skcb/core": "^0.2.0",
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
