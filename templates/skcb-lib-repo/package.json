{
  "name": "@my-org/skcb-lib-sample",
  "version": "1.0.0",
  "type": "module",
  "description": "Third-party function module for SurfingKeys Config Builder",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
