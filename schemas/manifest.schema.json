{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^(?!upstream$|core$)[a-z][a-z0-9_]*$"
    },
    "entries": {
      "type": "object",
      "patternProperties": {
        "^(?:actions|search-engines)\\.[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^core\\.[A-Za-z][A-Za-z0-9]*$"
              },
              "uniqueItems": true
            },
            "contributions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "kind": {
                    "enum": [
                      "mapkey",
                      "map",
                      "search"
                    ]
                  },
                  "alias": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "domain": {
                    "type": "string",
                    "pattern": "^(?:global|(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,})$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "search": {
                    "type": "string",
                    "minLength": 1
                  },
                  "compl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "favicon": {
                    "type": "string",
                    "minLength": 1
                  },
                  "callbackRequired": {
                    "type": "boolean"
                  },
                  "leader": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "alias"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "map"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "target"
                      ],
                      "properties": {
                        "callbackRequired": {
                          "const": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "mapkey"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "callbackRequired": {
                          "const": true
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "search"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "name",
                        "search"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "compl"
                      ]
                    },
                    "then": {
                      "required": [
                        "callbackRequired"
                      ],
                      "properties": {
                        "kind": {
                          "const": "search"
                        },
                        "callbackRequired": {
                          "const": true
                        }
                      }
                    }
                  }
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "entry",
            "contributions"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  },
  "required": [
    "schemaVersion",
    "namespace",
    "entries"
  ],
  "additionalProperties": false
}
