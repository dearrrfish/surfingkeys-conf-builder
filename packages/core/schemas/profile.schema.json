{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "locale": {
      "enum": [
        "en",
        "zh-CN"
      ]
    },
    "abstract": {
      "type": "boolean"
    },
    "extends": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "enum": [
        "minimal",
        "upstream-global"
      ]
    },
    "selectAdd": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines|omnibar|utils)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "selectRemove": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines|omnibar|utils)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "selectRemoveContributions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines|omnibar|utils)\\.[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "conflictResolution": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "prefer-later",
            "module-precedence"
          ]
        },
        "modulePrecedence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object"
    },
    "unsetSettings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "leaders": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string"
        },
        "search": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "keybindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines|omnibar|utils)\\.[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines|omnibar|utils)\\.[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "with": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:upstream|[a-z][a-z0-9_]*)/(?:actions|search-engines|omnibar|utils)\\.[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "target",
          "with"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "searchGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "leader": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "tabs",
              "hub",
              "both"
            ]
          },
          "layout": {
            "enum": [
              "auto",
              "grid",
              "tabs"
            ]
          },
          "engines": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "canIframe": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "url"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "hubUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "engines"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id"
  ],
  "additionalProperties": false
}
